{
	"name": "getontime-ontime",
	"version": "5.4.2-beta.2",
	"main": "/dist/index.js",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-getontime-ontime.git"
	},
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"dev": "yarn build:watch",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.json",
		"build:watch": "tsc -p tsconfig.json --watch",
		"lint": "eslint ./src --ext .ts",
		"lint:raw": "eslint --ext .ts --ext .js --ignore-pattern dist --ignore-pattern pkg",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build"
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-module/base": "2.2.1",
		"@getontime/resolver": "4.15.1",
		"companion-module-utils": "0.5.0",
		"semver": "^7.7.2",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"@types/semver": "^7.7.1",
		"@types/ws": "8.18.1",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"lint-staged": {
		"*.{js,json,md}": [
			"run prettier --write"
		],
		"*.ts": [
			"run lint --fix"
		]
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
